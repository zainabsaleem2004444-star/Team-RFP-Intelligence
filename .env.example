# ===== GEMINI API =====
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== SERVER CONFIG =====
# Backend server port (default: 3001)
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ===== DATABASE =====
# Path to SQLite database file
DATABASE_PATH=./data/rfp.db

# ===== REDIS (Queue) =====
# Redis connection URL (for local: redis://localhost:6379)
# For Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# ===== EMAIL NOTIFICATIONS =====
# Optional: For sending alerts when analysis finishes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=recipient@example.com

# ===== FILE STORAGE =====
# Path for uploaded RFP files
UPLOAD_DIR=./uploads

# Max file size (in bytes) - default 50MB
MAX_FILE_SIZE=52428800

# ===== SECURITY =====
# Rate limiting requests per 15 minutes
RATE_LIMIT=100

# Enable CORS for frontend (comma-separated)
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# ===== LOGGING =====
# Log level: error, warn, info, debug
LOG_LEVEL=debug
